# ==============================================================================
# E-Cüzdan v15 — Ortam Değişkenleri Şablonu (.env.example)
# ==============================================================================
# Bu dosyayı '.env' olarak kopyalayın ve kendi ortamınıza göre düzenleyin:
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TEMEL UYGULAMA VE GÜVENLİK AYARLARI
# ------------------------------------------------------------------------------
# Ortam: 'development', 'testing' veya 'production'
FLASK_ENV=development

# Oturum ve CSRF şifreleme anahtarı (Üretimde EN AZ 32 karakter güçlü rastgele bir değer olmalıdır!)
# Üretim için üretim komutu: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# Veritabanı Bağlantı URL'si (Varsayılan: yerel SQLite)
# Üretim örneği: postgresql+psycopg://kullanici:parola@localhost:5432/e_cuzdan
DATABASE_URL=sqlite:///e_cuzdan_v15.db

# ------------------------------------------------------------------------------
# 2. HTTPS VE TERS TERS PROXY (REVERSE PROXY) AYARLARI
# ------------------------------------------------------------------------------
# Canlı ortamda (production) her ikisi de 'true' olmak ZORUNDADIR.
HTTPS_ENABLED=false
FORCE_HTTPS=false

# Nginx/Traefik arkasındaysanız ters proxy atlama sayısı (X-Forwarded-For için)
TRUST_PROXY_HOPS=1

# ------------------------------------------------------------------------------
# 3. OTURUM (SESSION) VE KİMLİK DOĞRULAMA
# ------------------------------------------------------------------------------
# Kullanıcı oturum zaman aşımı süresi (saat)
SESSION_TIMEOUT_HOURS=2

# Uygulama yeniden başladığında eski oturumları geçersiz kılmak için isteğe bağlı boot ID
# APP_BOOT_ID=

# Google OAuth ile Giriş (İsteğe bağlı)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 4. FİNANSAL VE PİYASA VERİSİ AYARLARI
# ------------------------------------------------------------------------------
# Varsayılan para birimi (ISO 4217 kodu)
DEFAULT_CURRENCY=TRY

# Yıllık enflasyon oranı varsayımı (ondalık format: 0.40 = %40)
INFLATION_RATE=0.40

# Döviz ve Altın Sağlayıcı Zinciri (doviz.com -> TCMB -> Frankfurter -> GoldAPI -> yfinance)
FX_PROVIDER_CHAIN_ENABLED=true
FX_PROVIDER_TIMEOUT_SECONDS=8
FX_PROVIDER_RETRIES=1

# ------------------------------------------------------------------------------
# 5. ARKA PLAN SERVİSİ (BACKGROUND SERVICE)
# ------------------------------------------------------------------------------
# Canlı döviz/altın/hava durumu güncellemelerini çeken arka plan thread'i
BACKGROUND_SERVICE_ENABLED=true

# Arka plan işçisinin sahibi: 'web' (yerel geliştirme) veya 'worker' (üretim/worker.py)
BACKGROUND_WORKER_OWNER=web

# ------------------------------------------------------------------------------
# 6. HIZ SINIRLAMA (RATE LIMITING) VE REDIS
# ------------------------------------------------------------------------------
# Geliştirmede boş (bellek içi önbellek), üretimde 'redis://127.0.0.1:6379/0'
REDIS_URL=
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_KEY_PREFIX=ecuzdan:v15
RATELIMIT_REDIS_SOCKET_TIMEOUT_SECONDS=1
RATELIMIT_REDIS_CONNECT_TIMEOUT_SECONDS=1
RATELIMIT_IN_MEMORY_FALLBACK_ENABLED=true
