# E-Cüzdan v15 Environment Variables
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi girin

# Flask Konfigürasyonu
# CRITICAL: Production için güçlü bir SECRET_KEY mutlaka tanımlanmalıdır
# Python ile güvenli bir anahtar oluşturabilirsiniz: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FLASK_ENV=development
SESSION_TIMEOUT_HOURS=2

# Google OAuth Configuration (Phase 11 - Authentication Provider Framework)
# Google Cloud Console'dan alınan OAuth 2.0 Client ID ve Secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Logging (Faz 1-3)
LOG_LEVEL=INFO
# LOG_ALERTS_ENABLED=false
# LOG_ALERT_ERROR_THRESHOLD=10
# LOG_ALERT_CRITICAL_THRESHOLD=1

# Observability — Faz 4A (dev, opt-in)
# 1) pip install -r requirements-observability.txt
# 2) powershell -File scripts/start_observability.ps1
# 3) Uncomment below, then restart app
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# Jaeger UI: http://localhost:16686

# TCMB EVDS API (opsiyonel; fallback mekanizması anahtar olmadan da çalışır)
EVDS_API_KEY=
